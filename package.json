{
  "name": "@haiyue/ui",
  "version": "0.1.2",
  "private": false,
  "description": "Dependency-free Web Components for HaiyueStudio tools and products.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiyueStudio/UI.git"
  },
  "homepage": "https://haiyuestudio.github.io/UI/",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./themes/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./affix": {
      "types": "./dist/affix.d.ts",
      "import": "./dist/affix.js"
    },
    "./border-beam": {
      "types": "./dist/border-beam.d.ts",
      "import": "./dist/border-beam.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./breadcrumb": {
      "types": "./dist/breadcrumb.d.ts",
      "import": "./dist/breadcrumb.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./collapse": {
      "types": "./dist/collapse.d.ts",
      "import": "./dist/collapse.js"
    },
    "./cascader": {
      "types": "./dist/cascader.d.ts",
      "import": "./dist/cascader.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js"
    },
    "./context-menu": {
      "types": "./dist/context-menu.d.ts",
      "import": "./dist/context-menu.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./divider": {
      "types": "./dist/divider.d.ts",
      "import": "./dist/divider.js"
    },
    "./drawer": {
      "types": "./dist/drawer.d.ts",
      "import": "./dist/drawer.js"
    },
    "./dropdown": {
      "types": "./dist/dropdown.d.ts",
      "import": "./dist/dropdown.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./notification": {
      "types": "./dist/notification.d.ts",
      "import": "./dist/notification.js"
    },
    "./history-controls": {
      "types": "./dist/history-controls.d.ts",
      "import": "./dist/history-controls.js"
    },
    "./virtual-list": {
      "types": "./dist/virtual-list.d.ts",
      "import": "./dist/virtual-list.js"
    },
    "./virtual-mouse": {
      "types": "./dist/virtual-mouse.d.ts",
      "import": "./dist/virtual-mouse.js"
    },
    "./watermark": {
      "types": "./dist/watermark.d.ts",
      "import": "./dist/watermark.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./radio": {
      "types": "./dist/radio.d.ts",
      "import": "./dist/radio.js"
    },
    "./rate": {
      "types": "./dist/rate.d.ts",
      "import": "./dist/rate.js"
    },
    "./range": {
      "types": "./dist/range.d.ts",
      "import": "./dist/range.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "import": "./dist/skeleton.js"
    },
    "./split": {
      "types": "./dist/split.d.ts",
      "import": "./dist/split.js"
    },
    "./steps": {
      "types": "./dist/steps.d.ts",
      "import": "./dist/steps.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./tour": {
      "types": "./dist/tour.d.ts",
      "import": "./dist/tour.js"
    },
    "./time-picker": {
      "types": "./dist/time-picker.d.ts",
      "import": "./dist/time-picker.js"
    },
    "./timeline": {
      "types": "./dist/timeline.d.ts",
      "import": "./dist/timeline.js"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js"
    },
    "./themes/light.css": "./themes/haiyue-light.css",
    "./themes/dark.css": "./themes/haiyue-dark.css",
    "./package.json": "./package.json",
    "./expandable": {
      "types": "./dist/expandable.d.ts",
      "import": "./dist/expandable.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "themes/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "check:pages": "npm run build:pages && node scripts/verify-pages.mjs",
    "examples": "npm run build && node scripts/serve-examples.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run typecheck && npm test && npm run api:check",
    "pack:candidate": "node scripts/pack-candidate.mjs",
    "api:check": "node scripts/api-surface.mjs --check",
    "api:update": "node scripts/api-surface.mjs --write",
    "test:browser": "npm run build && playwright test",
    "verify:package": "npm run prepack && node scripts/verify-package.mjs",
    "release:check": "npm run verify:package && npm run test:browser && npm run check:pages"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "rollup": "^4.63.4",
    "typescript": "^5.2.0"
  }
}
